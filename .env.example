# Copy to .env.local for local development (never commit .env.local).

# --- Supabase (optional live pulses) ---
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Optional: only needed for `npx supabase link` / `db push` (not the browser app).
# Create at https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=
# Database password from Project Settings → Database
# SUPABASE_DB_PASSWORD=

# --- Google Maps Platform (optional richer place brief + Access POIs) ---
# Without this key, Harborbrief still works: BigDataCloud reverse-geocode,
# Open-Meteo weather, Wikipedia GeoSearch, and OSM Overpass (with labeled
# sample access points if Overpass is down).
#
# 1. Open https://console.cloud.google.com/ and create/select a project.
# 2. Enable billing (Maps Platform requires it; free monthly credit applies).
# 3. APIs & Services → Enable:
#      - Maps JavaScript API
#      - Places API
#      - Geocoding API
# 4. Credentials → Create credentials → API key.
# 5. Restrict the key:
#      Application restrictions → HTTP referrers
#        http://localhost:3000/*
#        https://dipak5501.github.io/*
#      API restrictions → restrict to the three APIs above.
# 6. Paste the key below (and as GitHub Actions secret NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
#    for the Pages deploy).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
